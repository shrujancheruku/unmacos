{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#eff1f5",
    "--editor-surface": "#eff1f5",
    "--foreground": "#4c4f69",
    "--card": "#d7d8dc",
    "--card-foreground": "#4c4f69",
    "--popover": "#dce0e8",
    "--popover-foreground": "#4c4f69",
    "--primary": "#1e66f5",
    "--primary-foreground": "#eff1f5",
    "--secondary": "#dce0e8",
    "--secondary-foreground": "#4c4f69",
    "--muted": "#d7d8dc",
    "--muted-foreground": "#acb0be",
    "--accent": "#ccd0da",
    "--accent-foreground": "#4c4f69",
    "--border": "#acb0be",
    "--input": "#acb0be",
    "--ring": "#1e66f5",
    "--sidebar": "#e3e4e8",
    "--sidebar-foreground": "#4c4f69",
    "--sidebar-primary": "#1e66f5",
    "--sidebar-primary-foreground": "#eff1f5",
    "--sidebar-accent": "#ccd0da",
    "--sidebar-accent-foreground": "#4c4f69",
    "--sidebar-border": "#acb0be",
    "--sidebar-ring": "#1e66f5",
    "--worktree-sidebar": "#e3e4e8",
    "--worktree-sidebar-foreground": "#4c4f69",
    "--worktree-sidebar-accent": "#dce0e8",
    "--worktree-sidebar-accent-foreground": "#4c4f69",
    "--worktree-sidebar-border": "#acb0be",
    "--worktree-sidebar-ring": "#1e66f5",
    "--worktree-sidebar-active": "#ccd0da",
    "--worktree-sidebar-active-border": "#1e66f5",
    "--tab-bar": "#e3e4e8",
    "--tab-active": "#eff1f5",
    "--tab-active-foreground": "#4c4f69",
    "--tab-active-indicator": "#1e66f5",
    "--tab-inactive": "#e3e4e8",
    "--tab-inactive-foreground": "#acb0be",
    "--split-divider": "#acb0be",
    "--split-divider-hover": "#1e66f5",
    "--text-link": "#1e66f5",
    "--diff-added": "#40a02b",
    "--diff-removed": "#d20f39",
    "--git-decoration-added": "#40a02b",
    "--git-decoration-modified": "#df8e1d",
    "--git-decoration-deleted": "#d20f39",
    "--chart-1": "#1e66f5",
    "--chart-2": "#40a02b",
    "--chart-3": "#df8e1d",
    "--chart-4": "#ea76cb",
    "--chart-5": "#179299"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#acb0be", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#ea76cb" } },
    { "scope": "string", "settings": { "foreground": "#40a02b" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#d84e2b" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#1e66f5" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#179299" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#df8e1d" } }
  ]
}
