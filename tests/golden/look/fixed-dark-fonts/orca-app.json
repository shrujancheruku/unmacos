{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#1a1b26",
    "--editor-surface": "#1a1b26",
    "--foreground": "#c0caf5",
    "--card": "#1f2335",
    "--card-foreground": "#c0caf5",
    "--popover": "#24283b",
    "--popover-foreground": "#c0caf5",
    "--primary": "#7aa2f7",
    "--primary-foreground": "#1a1b26",
    "--secondary": "#24283b",
    "--secondary-foreground": "#c0caf5",
    "--muted": "#1f2335",
    "--muted-foreground": "#565f89",
    "--accent": "#414868",
    "--accent-foreground": "#c0caf5",
    "--border": "#3b4261",
    "--input": "#3b4261",
    "--ring": "#7aa2f7",
    "--sidebar": "#16161e",
    "--sidebar-foreground": "#c0caf5",
    "--sidebar-primary": "#7aa2f7",
    "--sidebar-primary-foreground": "#1a1b26",
    "--sidebar-accent": "#414868",
    "--sidebar-accent-foreground": "#c0caf5",
    "--sidebar-border": "#3b4261",
    "--sidebar-ring": "#7aa2f7",
    "--worktree-sidebar": "#16161e",
    "--worktree-sidebar-foreground": "#c0caf5",
    "--worktree-sidebar-accent": "#24283b",
    "--worktree-sidebar-accent-foreground": "#c0caf5",
    "--worktree-sidebar-border": "#3b4261",
    "--worktree-sidebar-ring": "#7aa2f7",
    "--worktree-sidebar-active": "#414868",
    "--worktree-sidebar-active-border": "#7aa2f7",
    "--tab-bar": "#16161e",
    "--tab-active": "#1a1b26",
    "--tab-active-foreground": "#c0caf5",
    "--tab-active-indicator": "#7aa2f7",
    "--tab-inactive": "#16161e",
    "--tab-inactive-foreground": "#565f89",
    "--split-divider": "#3b4261",
    "--split-divider-hover": "#7aa2f7",
    "--text-link": "#7aa2f7",
    "--diff-added": "#9ece6a",
    "--diff-removed": "#f7768e",
    "--git-decoration-added": "#9ece6a",
    "--git-decoration-modified": "#e0af68",
    "--git-decoration-deleted": "#f7768e",
    "--chart-1": "#7aa2f7",
    "--chart-2": "#9ece6a",
    "--chart-3": "#e0af68",
    "--chart-4": "#bb9af7",
    "--chart-5": "#7dcfff"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#565f89", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#bb9af7" } },
    { "scope": "string", "settings": { "foreground": "#9ece6a" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#7dcfff" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#e0af68" } }
  ]
}
