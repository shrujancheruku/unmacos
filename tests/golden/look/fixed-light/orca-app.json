{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#fffcf0",
    "--editor-surface": "#fffcf0",
    "--foreground": "#100f0f",
    "--card": "#e5e2d8",
    "--card-foreground": "#100f0f",
    "--popover": "#e6e4d9",
    "--popover-foreground": "#100f0f",
    "--primary": "#205ea6",
    "--primary-foreground": "#fffcf0",
    "--secondary": "#e6e4d9",
    "--secondary-foreground": "#100f0f",
    "--muted": "#e5e2d8",
    "--muted-foreground": "#b7b5ac",
    "--accent": "#cecdc3",
    "--accent-foreground": "#100f0f",
    "--border": "#b7b5ac",
    "--input": "#b7b5ac",
    "--ring": "#205ea6",
    "--sidebar": "#f2efe4",
    "--sidebar-foreground": "#100f0f",
    "--sidebar-primary": "#205ea6",
    "--sidebar-primary-foreground": "#fffcf0",
    "--sidebar-accent": "#cecdc3",
    "--sidebar-accent-foreground": "#100f0f",
    "--sidebar-border": "#b7b5ac",
    "--sidebar-ring": "#205ea6",
    "--worktree-sidebar": "#f2efe4",
    "--worktree-sidebar-foreground": "#100f0f",
    "--worktree-sidebar-accent": "#e6e4d9",
    "--worktree-sidebar-accent-foreground": "#100f0f",
    "--worktree-sidebar-border": "#b7b5ac",
    "--worktree-sidebar-ring": "#205ea6",
    "--worktree-sidebar-active": "#cecdc3",
    "--worktree-sidebar-active-border": "#205ea6",
    "--tab-bar": "#f2efe4",
    "--tab-active": "#fffcf0",
    "--tab-active-foreground": "#100f0f",
    "--tab-active-indicator": "#205ea6",
    "--tab-inactive": "#f2efe4",
    "--tab-inactive-foreground": "#b7b5ac",
    "--split-divider": "#b7b5ac",
    "--split-divider-hover": "#205ea6",
    "--text-link": "#205ea6",
    "--diff-added": "#879a39",
    "--diff-removed": "#d14d41",
    "--git-decoration-added": "#879a39",
    "--git-decoration-modified": "#d0a215",
    "--git-decoration-deleted": "#d14d41",
    "--chart-1": "#205ea6",
    "--chart-2": "#879a39",
    "--chart-3": "#d0a215",
    "--chart-4": "#ce5d97",
    "--chart-5": "#3aa99f"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#b7b5ac", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#ce5d97" } },
    { "scope": "string", "settings": { "foreground": "#879a39" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#d0772b" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#205ea6" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#3aa99f" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#d0a215" } }
  ]
}
