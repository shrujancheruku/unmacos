{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#2e3440",
    "--editor-surface": "#2e3440",
    "--foreground": "#d8dee9",
    "--card": "#191c23",
    "--card-foreground": "#d8dee9",
    "--popover": "#3b4252",
    "--popover-foreground": "#d8dee9",
    "--primary": "#81a1c1",
    "--primary-foreground": "#2e3440",
    "--secondary": "#3b4252",
    "--secondary-foreground": "#d8dee9",
    "--muted": "#191c23",
    "--muted-foreground": "#4c566a",
    "--accent": "#434c5e",
    "--accent-foreground": "#d8dee9",
    "--border": "#4c566a",
    "--input": "#4c566a",
    "--ring": "#81a1c1",
    "--sidebar": "#222730",
    "--sidebar-foreground": "#d8dee9",
    "--sidebar-primary": "#81a1c1",
    "--sidebar-primary-foreground": "#2e3440",
    "--sidebar-accent": "#434c5e",
    "--sidebar-accent-foreground": "#d8dee9",
    "--sidebar-border": "#4c566a",
    "--sidebar-ring": "#81a1c1",
    "--worktree-sidebar": "#222730",
    "--worktree-sidebar-foreground": "#d8dee9",
    "--worktree-sidebar-accent": "#3b4252",
    "--worktree-sidebar-accent-foreground": "#d8dee9",
    "--worktree-sidebar-border": "#4c566a",
    "--worktree-sidebar-ring": "#81a1c1",
    "--worktree-sidebar-active": "#434c5e",
    "--worktree-sidebar-active-border": "#81a1c1",
    "--tab-bar": "#222730",
    "--tab-active": "#2e3440",
    "--tab-active-foreground": "#d8dee9",
    "--tab-active-indicator": "#81a1c1",
    "--tab-inactive": "#222730",
    "--tab-inactive-foreground": "#4c566a",
    "--split-divider": "#4c566a",
    "--split-divider-hover": "#81a1c1",
    "--text-link": "#81a1c1",
    "--diff-added": "#a3be8c",
    "--diff-removed": "#bf616a",
    "--git-decoration-added": "#a3be8c",
    "--git-decoration-modified": "#ebcb8b",
    "--git-decoration-deleted": "#bf616a",
    "--chart-1": "#81a1c1",
    "--chart-2": "#a3be8c",
    "--chart-3": "#ebcb8b",
    "--chart-4": "#b48ead",
    "--chart-5": "#88c0d0"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#4c566a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#b48ead" } },
    { "scope": "string", "settings": { "foreground": "#a3be8c" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#d5967a" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#81a1c1" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#88c0d0" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#ebcb8b" } }
  ]
}
