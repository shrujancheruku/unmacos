# UnMacOS — core desktop
# Everything the Omarchy-style desktop and terminal setup needs.
# Personal apps live in Brewfile.personal (installed only when you opt in).

# --- Taps ---
tap "acsandmann/tap"       # Rift window manager
tap "felixkratz/formulae"  # SketchyBar, borders
tap "smudge/smudge"        # nightlight (Night Shift CLI)

# --- Desktop ---
brew "acsandmann/tap/rift", trusted: true            # Tiling window manager
brew "felixkratz/formulae/sketchybar", trusted: true # Status bar
brew "felixkratz/formulae/borders", trusted: true    # Window borders
brew "lua"                                           # Runs sketchybarrc (SbarLua)
brew "nowplaying-cli"                                # Bar media widget
brew "switchaudio-osx"                               # Bar volume widget + audio picker
brew "blueutil"                                      # Bluetooth picker
brew "smudge/smudge/nightlight", trusted: true       # Night Shift toggle
brew "television"                                    # Launcher and every picker
brew "mas"                                           # Mac App Store CLI

# --- Terminal ---
cask "ghostty"
brew "tmux"
brew "neovim"
brew "nnn"           # File manager
brew "btop"          # Activity monitor
brew "lazygit"
brew "lazydocker"
brew "spotify_player" # Music TUI
brew "starship"
brew "zoxide"
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "fzf"
brew "jq"
brew "git"
brew "git-delta"
brew "gh"
brew "gitleaks"
brew "shellcheck"
brew "thefuck"
brew "tlrc"
brew "fastfetch"
brew "wget"
brew "go"            # Builds clipse (clipboard history)
brew "uv"            # Installs pywalfox (Firefox theme)
brew "chezmoi"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# --- Apps ---
cask "1password"
cask "1password-cli"
cask "firefox"       # Default browser (Alt + Shift + B)

# --- Fonts ---
cask "font-sketchybar-app-font"
cask "font-geist-mono-nerd-font"
cask "font-hack-nerd-font"
cask "font-victor-mono-nerd-font"
cask "font-sf-mono"
cask "font-sf-pro"
cask "sf-symbols"
