# Developer tools: languages, databases, cloud CLIs, Android, containers
tap "oven-sh/bun"
tap "stablyai/orca"
tap "supabase/tap"

brew "rust"                                  # Rust toolchain
brew "openjdk"                               # Java
brew "julia"                                 # Julia
brew "nvm"                                   # Node version manager
brew "pnpm"                                  # Node packages (pnpm)
brew "yarn"                                  # Node packages (Yarn)
brew "oven-sh/bun/bun", trusted: true        # Bun JavaScript runtime
brew "composer"                              # PHP packages
brew "luarocks"                              # Lua packages
brew "cocoapods"                             # iOS packages
brew "postgresql@18"                         # PostgreSQL
brew "supabase/tap/supabase", trusted: true  # Supabase CLI
brew "cloudflared"                           # Cloudflare Tunnel
brew "wireguard-tools"                       # WireGuard CLI
cask "gcloud-cli"                            # Google Cloud CLI
cask "android-cli"                           # Android CLI
cask "android-platform-tools"                # adb, fastboot
cask "zulu@17"                               # Java 17 (Android builds)
cask "orbstack"                              # Docker and Linux VMs
cask "claude-code"                           # Claude Code
cask "stablyai/orca/orca", trusted: true     # Orca (agent IDE)
