# Everyday apps: browser, chat, VPN, utilities
tap "achannarasappa/tap"
tap "luckman212/tap"

cask "google-chrome"                             # Second browser
cask "slack"                                     # Slack
cask "whatsapp"                                  # WhatsApp
cask "mullvad-vpn"                               # Mullvad VPN
cask "logi-options+"                             # Logitech mouse and keyboard settings
cask "the-unarchiver"                            # Opens every archive format
cask "calibre"                                   # E-book library
cask "transmission"                              # BitTorrent client
cask "tradingview"                               # Charts and markets
brew "achannarasappa/tap/ticker", trusted: true  # Stock ticker in the terminal
brew "luckman212/tap/volctl", trusted: true      # Per-app volume CLI
brew "mole"                                      # Cleans caches and leftovers
