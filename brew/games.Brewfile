# Games: Steam, Epic/GOG, Windows games through Wine
cask "steam"         # Steam
cask "heroic"        # Epic, GOG and Amazon games
cask "porting-kit"   # Windows games through Wine
brew "cabextract"    # Wine helper (Porting Kit)
brew "zenity"        # Wine helper dialogs (Porting Kit)
brew "zork"          # A text adventure
