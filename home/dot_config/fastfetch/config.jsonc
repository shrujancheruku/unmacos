// UnMacOS: fastfetch
// Sized for a quarter-screen Ghostty tile on a 14" MacBook Pro (about 75 x 21
// cells at font-size 16): a 16-line logo beside 16 info lines, no line over 70 cols.
// Colours are plain ANSI, so they follow the active UnMacOS theme.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // fastfetch's builtin "macOS3" rainbow Apple (from neofetch), copied to fix
    // the stray backslashes the builtin prints on its fourth line
    "type": "file",
    "source": "~/.config/fastfetch/apple.txt",
    "color": { "1": "green", "2": "yellow", "3": "bright_red", "4": "red", "5": "magenta", "6": "blue" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 5 },
    "color": { "keys": "blue", "title": "magenta" },
    "size": { "binaryPrefix": "iec", "ndigits": 0 },
    "percent": { "type": 3 },
    "bar": { "width": 8 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "", "format": "{name} {version} {codename}" },
    { "type": "host", "key": "󰌢", "format": "{name}" },
    { "type": "kernel", "key": "", "format": "{sysname} {release}" },
    { "type": "uptime", "key": "󰅐" },
    { "type": "packages", "key": "󰏖" },
    { "type": "shell", "key": "", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "", "format": "{pretty-name}" },
    { "type": "cpu", "key": "", "format": "{name} ({cores-physical})" },
    { "type": "gpu", "key": "󰢮", "format": "{core-count}-core GPU" },
    { "type": "memory", "key": "󰍛", "format": "{used} / {total} {percentage-bar}" },
    { "type": "disk", "key": "󰋊", "folders": "/", "format": "{size-used} / {size-total} {size-percentage-bar}" },
    { "type": "battery", "key": "󰁹", "format": "{capacity} {status}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 6 }
  ]
}
