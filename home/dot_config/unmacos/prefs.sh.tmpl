{{- /* One export per Setting that has an env name in the Settings schema. Sorted by name, so the file doesn't change when the schema is reordered. */ -}}
{{- $exports := dict -}}
{{- range .settings -}}
  {{- $env := get . "env" -}}
  {{- if $env -}}
    {{- $v := index (index $ .group) .key -}}
    {{- if ne .type "bool" }}{{ $_ := set $exports $env (toString $v) }}{{ else if $v }}{{ $_ := set $exports $env "1" }}{{ end -}}
  {{- end -}}
{{- end -}}
# shellcheck shell=bash
# UnMacOS: the Settings that scripts read from the environment (generated from the Settings
# schema, with your values from ~/.config/unmacos/setup.toml). Sourced by the setup scripts and
# theme commands. Generated by chezmoi: change it with unmacos-setup. A value already in the
# environment wins, so `UNMACOS_KEEP_X=1 chezmoi apply` still works for one run.
{{- range $env, $v := $exports }}
{{ printf "export %s=\"${%s:-%s}\"" $env $env $v }}
{{- end }}
:
