# UnMacOS: what unmacos-setup told it to leave alone (from [data.keep] in
# ~/.config/chezmoi/chezmoi.toml). Sourced by the setup scripts and theme commands.
# Generated by chezmoi: change it with unmacos-setup. An UNMACOS_KEEP_* already in the
# environment wins, so `UNMACOS_KEEP_X=1 chezmoi apply` still works for one run.
{{- range $k, $v := .keep }}
{{- if $v }}
export UNMACOS_KEEP_{{ upper $k }}="${UNMACOS_KEEP_{{ upper $k }}:-1}"
{{- end }}
{{- end }}
:
