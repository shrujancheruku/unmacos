#!/bin/bash
# UnMacOS: render the active theme. Re-runs when themes or templates change.
# {{ range (glob (joinPath .chezmoi.sourceDir "dot_local/share/unmacos/templates/*")) }}{{ include . | sha256sum | trunc 12 }} {{ end }}
# {{ range (glob (joinPath .chezmoi.sourceDir "dot_local/share/unmacos/themes/*/*")) }}{{ include . | sha256sum | trunc 12 }} {{ end }}
set -euo pipefail
"$HOME/.local/bin/unmacos-theme-render" "$(cat "$HOME/.local/state/unmacos/theme.name" 2>/dev/null || echo {{ .theme }})"
