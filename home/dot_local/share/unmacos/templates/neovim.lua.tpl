-- Generated by unmacos-theme-render (themes without a neovim.lua override):
-- a base16 colourscheme built from the theme's own palette, so Neovim matches
-- the terminal for every theme.
local function apply()
	vim.o.background = "{{ mode }}"
	require("mini.base16").setup({
		palette = {
			base00 = "{{ background }}",
			base01 = "{{ lighter_background }}",
			base02 = "{{ selection }}",
			base03 = "{{ muted }}",
			base04 = "{{ dark_foreground }}",
			base05 = "{{ foreground }}",
			base06 = "{{ light_foreground }}",
			base07 = "{{ bright_foreground }}",
			base08 = "{{ red }}",
			base09 = "{{ orange }}",
			base0A = "{{ yellow }}",
			base0B = "{{ green }}",
			base0C = "{{ cyan }}",
			base0D = "{{ blue }}",
			base0E = "{{ magenta }}",
			base0F = "{{ brown }}",
		},
	})
	vim.g.colors_name = "unmacos"
	-- Let lualine, bufferline and friends pick up the new colours
	vim.api.nvim_exec_autocmds("ColorScheme", { pattern = "unmacos" })
end

return { { "LazyVim/LazyVim", opts = { colorscheme = apply } } }
