-- Generated by unmacos-look (themes without a neovim.lua override):
-- a base16 colourscheme built from the theme's own palette, so Neovim matches
-- the terminal for every theme.
local function apply()
	vim.o.background = "{{ .theme.mode }}"
	require("mini.base16").setup({
		palette = {
			base00 = "{{ .color.background }}",
			base01 = "{{ .color.lighter_background }}",
			base02 = "{{ .color.selection }}",
			base03 = "{{ .color.muted }}",
			base04 = "{{ .color.dark_foreground }}",
			base05 = "{{ .color.foreground }}",
			base06 = "{{ .color.light_foreground }}",
			base07 = "{{ .color.bright_foreground }}",
			base08 = "{{ .color.red }}",
			base09 = "{{ .color.orange }}",
			base0A = "{{ .color.yellow }}",
			base0B = "{{ .color.green }}",
			base0C = "{{ .color.cyan }}",
			base0D = "{{ .color.blue }}",
			base0E = "{{ .color.magenta }}",
			base0F = "{{ .color.brown }}",
		},
	})
	vim.g.colors_name = "unmacos"
	-- Let lualine, bufferline and friends pick up the new colours
	vim.api.nvim_exec_autocmds("ColorScheme", { pattern = "unmacos" })
end

return { { "LazyVim/LazyVim", opts = { colorscheme = apply } } }
