-- Generated by unmacos-theme-render. Do not edit; edit the theme's colors.toml.
return {
	black = 0xff{{ .bare.background }},
	white = 0xff{{ .bare.foreground }},
	red = 0xff{{ .bare.red }},
	green = 0xff{{ .bare.green }},
	blue = 0xff{{ .bare.blue }},
	yellow = 0xff{{ .bare.yellow }},
	orange = 0xff{{ .bare.orange }},
	magenta = 0xff{{ .bare.magenta }},
	grey = 0xff{{ .bare.muted }},
	accent = 0xff{{ .bare.accent }},
	bar_bg = 0x00{{ .bare.background }},
	bar_border = 0xff{{ .bare.bar_border }},
	popup_bg = 0xc0{{ .bare.darker_background }},
	popup_border = 0xff{{ .bare.muted }},
	bg1 = 0xff{{ .bare.darker_background }},
	bg2 = 0xff{{ .bare.lighter_background }},
	-- Look Setting, not a colour: chips and popups round like the windows
	corner_radius = {{ .look.corner_radius }},
	bar_height = {{ .look.bar_height }},
	chip_height = {{ sub (.look.bar_height | int) 14 }}, -- chips follow the bar
	bar_position = "{{ .look.bar_position }}",
	-- The bar's font and the weights it has: each family spells (or lacks) them differently
	font_text = "{{ .look.bar_font }}",
{{- $semibold := "SemiBold" }}{{ $heavy := "ExtraBold" }}{{ $black := "Black" }}
{{- if eq .look.bar_font "Hack Nerd Font" }}{{ $semibold = "Bold" }}{{ $heavy = "Bold" }}{{ $black = "Bold" }}{{ end }}
{{- if eq .look.bar_font "VictorMono Nerd Font" }}{{ $heavy = "Bold" }}{{ $black = "Bold" }}{{ end }}
	font_styles = {
		Regular = "Regular",
		Semibold = "{{ $semibold }}",
		Bold = "Bold",
		Heavy = "{{ $heavy }}",
		Black = "{{ $black }}",
	},
}
