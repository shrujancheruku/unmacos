# Generated by unmacos-theme-render
set -g status-style "bg={{ background }},fg={{ foreground }}"
set -g status-left-style "fg={{ accent }},bold"
set -g window-status-current-style "fg={{ accent }},bold"
set -g window-status-style "fg={{ muted }}"
set -g pane-border-style "fg={{ border_inactive }}"
set -g pane-active-border-style "fg={{ accent }}"
set -g message-style "bg={{ lighter_background }},fg={{ foreground }}"
set -g mode-style "bg={{ selection }},fg={{ foreground }}"
