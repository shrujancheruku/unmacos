# Generated by unmacos-theme-render
set -g status-style "bg={{ .theme.background }},fg={{ .theme.foreground }}"
set -g status-left-style "fg={{ .theme.accent }},bold"
set -g window-status-current-style "fg={{ .theme.accent }},bold"
set -g window-status-style "fg={{ .theme.muted }}"
set -g pane-border-style "fg={{ .theme.border_inactive }}"
set -g pane-active-border-style "fg={{ .theme.accent }}"
set -g message-style "bg={{ .theme.lighter_background }},fg={{ .theme.foreground }}"
set -g mode-style "bg={{ .theme.selection }},fg={{ .theme.foreground }}"
