{
  "schemaVersion": 1,
  "base": "{{ .theme.mode }}",
  "tokens": {
    "--background": "{{ .theme.background }}",
    "--editor-surface": "{{ .theme.background }}",
    "--foreground": "{{ .theme.foreground }}",
    "--card": "{{ .theme.darker_background }}",
    "--card-foreground": "{{ .theme.foreground }}",
    "--popover": "{{ .theme.lighter_background }}",
    "--popover-foreground": "{{ .theme.foreground }}",
    "--primary": "{{ .theme.accent }}",
    "--primary-foreground": "{{ .theme.background }}",
    "--secondary": "{{ .theme.lighter_background }}",
    "--secondary-foreground": "{{ .theme.foreground }}",
    "--muted": "{{ .theme.darker_background }}",
    "--muted-foreground": "{{ .theme.muted }}",
    "--accent": "{{ .theme.selection }}",
    "--accent-foreground": "{{ .theme.foreground }}",
    "--border": "{{ .theme.border_inactive }}",
    "--input": "{{ .theme.border_inactive }}",
    "--ring": "{{ .theme.accent }}",
    "--sidebar": "{{ .theme.dark_background }}",
    "--sidebar-foreground": "{{ .theme.foreground }}",
    "--sidebar-primary": "{{ .theme.accent }}",
    "--sidebar-primary-foreground": "{{ .theme.background }}",
    "--sidebar-accent": "{{ .theme.selection }}",
    "--sidebar-accent-foreground": "{{ .theme.foreground }}",
    "--sidebar-border": "{{ .theme.border_inactive }}",
    "--sidebar-ring": "{{ .theme.accent }}",
    "--worktree-sidebar": "{{ .theme.dark_background }}",
    "--worktree-sidebar-foreground": "{{ .theme.foreground }}",
    "--worktree-sidebar-accent": "{{ .theme.lighter_background }}",
    "--worktree-sidebar-accent-foreground": "{{ .theme.foreground }}",
    "--worktree-sidebar-border": "{{ .theme.border_inactive }}",
    "--worktree-sidebar-ring": "{{ .theme.accent }}",
    "--worktree-sidebar-active": "{{ .theme.selection }}",
    "--worktree-sidebar-active-border": "{{ .theme.accent }}",
    "--tab-bar": "{{ .theme.dark_background }}",
    "--tab-active": "{{ .theme.background }}",
    "--tab-active-foreground": "{{ .theme.foreground }}",
    "--tab-active-indicator": "{{ .theme.accent }}",
    "--tab-inactive": "{{ .theme.dark_background }}",
    "--tab-inactive-foreground": "{{ .theme.muted }}",
    "--split-divider": "{{ .theme.border_inactive }}",
    "--split-divider-hover": "{{ .theme.accent }}",
    "--text-link": "{{ .theme.blue }}",
    "--diff-added": "{{ .theme.green }}",
    "--diff-removed": "{{ .theme.red }}",
    "--git-decoration-added": "{{ .theme.green }}",
    "--git-decoration-modified": "{{ .theme.yellow }}",
    "--git-decoration-deleted": "{{ .theme.red }}",
    "--chart-1": "{{ .theme.blue }}",
    "--chart-2": "{{ .theme.green }}",
    "--chart-3": "{{ .theme.yellow }}",
    "--chart-4": "{{ .theme.magenta }}",
    "--chart-5": "{{ .theme.cyan }}"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "{{ .theme.muted }}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "{{ .theme.magenta }}" } },
    { "scope": "string", "settings": { "foreground": "{{ .theme.green }}" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "{{ .theme.orange }}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "{{ .theme.blue }}" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "{{ .theme.cyan }}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{ .theme.yellow }}" } }
  ]
}
