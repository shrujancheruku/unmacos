{
  "schemaVersion": 1,
  "base": "{{ .theme.mode }}",
  "tokens": {
    "--background": "{{ .color.background }}",
    "--editor-surface": "{{ .color.background }}",
    "--foreground": "{{ .color.foreground }}",
    "--card": "{{ .color.darker_background }}",
    "--card-foreground": "{{ .color.foreground }}",
    "--popover": "{{ .color.lighter_background }}",
    "--popover-foreground": "{{ .color.foreground }}",
    "--primary": "{{ .color.accent }}",
    "--primary-foreground": "{{ .color.background }}",
    "--secondary": "{{ .color.lighter_background }}",
    "--secondary-foreground": "{{ .color.foreground }}",
    "--muted": "{{ .color.darker_background }}",
    "--muted-foreground": "{{ .color.muted }}",
    "--accent": "{{ .color.selection }}",
    "--accent-foreground": "{{ .color.foreground }}",
    "--border": "{{ .color.border_inactive }}",
    "--input": "{{ .color.border_inactive }}",
    "--ring": "{{ .color.accent }}",
    "--sidebar": "{{ .color.dark_background }}",
    "--sidebar-foreground": "{{ .color.foreground }}",
    "--sidebar-primary": "{{ .color.accent }}",
    "--sidebar-primary-foreground": "{{ .color.background }}",
    "--sidebar-accent": "{{ .color.selection }}",
    "--sidebar-accent-foreground": "{{ .color.foreground }}",
    "--sidebar-border": "{{ .color.border_inactive }}",
    "--sidebar-ring": "{{ .color.accent }}",
    "--worktree-sidebar": "{{ .color.dark_background }}",
    "--worktree-sidebar-foreground": "{{ .color.foreground }}",
    "--worktree-sidebar-accent": "{{ .color.lighter_background }}",
    "--worktree-sidebar-accent-foreground": "{{ .color.foreground }}",
    "--worktree-sidebar-border": "{{ .color.border_inactive }}",
    "--worktree-sidebar-ring": "{{ .color.accent }}",
    "--worktree-sidebar-active": "{{ .color.selection }}",
    "--worktree-sidebar-active-border": "{{ .color.accent }}",
    "--tab-bar": "{{ .color.dark_background }}",
    "--tab-active": "{{ .color.background }}",
    "--tab-active-foreground": "{{ .color.foreground }}",
    "--tab-active-indicator": "{{ .color.accent }}",
    "--tab-inactive": "{{ .color.dark_background }}",
    "--tab-inactive-foreground": "{{ .color.muted }}",
    "--split-divider": "{{ .color.border_inactive }}",
    "--split-divider-hover": "{{ .color.accent }}",
    "--text-link": "{{ .color.blue }}",
    "--diff-added": "{{ .color.green }}",
    "--diff-removed": "{{ .color.red }}",
    "--git-decoration-added": "{{ .color.green }}",
    "--git-decoration-modified": "{{ .color.yellow }}",
    "--git-decoration-deleted": "{{ .color.red }}",
    "--chart-1": "{{ .color.blue }}",
    "--chart-2": "{{ .color.green }}",
    "--chart-3": "{{ .color.yellow }}",
    "--chart-4": "{{ .color.magenta }}",
    "--chart-5": "{{ .color.cyan }}"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "{{ .color.muted }}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "{{ .color.magenta }}" } },
    { "scope": "string", "settings": { "foreground": "{{ .color.green }}" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "{{ .color.orange }}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "{{ .color.blue }}" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "{{ .color.cyan }}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{ .color.yellow }}" } }
  ]
}
