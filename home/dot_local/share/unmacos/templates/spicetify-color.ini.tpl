; UnMacOS: Spicetify color scheme, rendered by unmacos-theme-render.
; ~/.config/spicetify/Themes/UnMacOS/color.ini links here; Spicetify wants
; hex without the leading #.
[UnMacOS]
text               = {{ foreground_strip }}
subtext            = {{ dark_foreground_strip }}
main               = {{ background_strip }}
main-elevated      = {{ lighter_background_strip }}
main-secondary     = {{ darker_background_strip }}
highlight          = {{ selection_strip }}
highlight-elevated = {{ selection_strip }}
sidebar            = {{ dark_background_strip }}
player             = {{ dark_background_strip }}
card               = {{ lighter_background_strip }}
shadow             = {{ dark_background_strip }}
selected-row       = {{ dark_foreground_strip }}
button             = {{ accent_strip }}
button-active      = {{ accent_strip }}
button-secondary   = {{ muted_strip }}
button-disabled    = {{ selection_strip }}
tab-active         = {{ selection_strip }}
nav-active         = {{ accent_strip }}
nav-active-text    = {{ background_strip }}
play-button        = {{ accent_strip }}
playback-bar       = {{ accent_strip }}
notification       = {{ selection_strip }}
notification-error = {{ red_strip }}
misc               = {{ muted_strip }}
