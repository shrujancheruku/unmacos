#!/usr/bin/env bash
# UnMacOS: match macOS's accent and highlight colours to the current theme.
#   unmacos-accent [theme]     default: current theme
#   unmacos-accent --reset     back to macOS defaults (Multicolor accent)
# The highlight colour (text selection) takes any colour, so it gets the
# theme's selection colour. The accent colour (buttons, checkboxes, focus rings,
# sidebar and folder icons) only takes macOS's presets, so it gets the one
# nearest the theme's accent by hue, or Graphite for near-grey accents.
# Running apps are told the colours changed; a few only update on relaunch.
set -euo pipefail

SHARE="${UNMACOS_SHARE:-$HOME/.local/share/unmacos}"
STATE="${UNMACOS_STATE:-$HOME/.local/state/unmacos}"

notify() {
  # shellcheck disable=SC2016 # the JavaScript passed to osascript uses $, not shell variables
  osascript -l JavaScript -e '
    ObjC.import("Foundation");
    const c = $.NSDistributedNotificationCenter.defaultCenter;
    for (const n of ["AppleColorPreferencesChangedNotification", "AppleAquaColorVariantChanged"])
      c.postNotificationNameObjectUserInfoDeliverImmediately(n, $(), $(), true);' >/dev/null 2>&1 || true
}

if [[ "${1:-}" == --reset ]]; then
  defaults delete -g AppleAccentColor 2>/dev/null || true
  defaults delete -g AppleHighlightColor 2>/dev/null || true
  notify
  exit 0
fi

theme="${1:-$(cat "$STATE/theme.name" 2>/dev/null || echo tokyo-night)}"
colors="$SHARE/themes/$theme/colors.toml"
[[ -f "$colors" ]] || { echo "unmacos-accent: no theme '$theme'" >&2; exit 1; }
get() { awk -F'"' -v k="$1" '$1 ~ "^"k" *= *$" {print $2; exit}' "$colors"; }
accent="$(get accent)"; selection="$(get selection)"

# Accent: AppleAccentColor -1 Graphite, 0 Red, 1 Orange, 2 Yellow, 3 Green,
# 4 Blue, 5 Purple, 6 Pink (unset = Multicolor)
hex="${accent#\#}"
preset="$(awk -v r=$((16#${hex:0:2})) -v g=$((16#${hex:2:2})) -v b=$((16#${hex:4:2})) 'BEGIN {
    r/=255; g/=255; b/=255
    mx = r; if (g > mx) mx = g; if (b > mx) mx = b
    mn = r; if (g < mn) mn = g; if (b < mn) mn = b
    d = mx - mn; l = (mx + mn) / 2; t = 2*l - 1; if (t < 0) t = -t
    s = (d == 0) ? 0 : d / (1 - t)
    if (s < 0.18 || d < 0.08) { print -1; exit }
    if (mx == r) { h = 60 * ((g - b) / d); } else if (mx == g) { h = 60 * ((b - r) / d + 2) } else { h = 60 * ((r - g) / d + 4) }
    if (h < 0) h += 360
    if (h < 10 || h >= 340) print 0; else if (h < 42) print 1; else if (h < 70) print 2
    else if (h < 165) print 3; else if (h < 250) print 4; else if (h < 300) print 5; else print 6
  }')"
defaults write -g AppleAccentColor -int "$preset"

# Highlight: "r g b Other", each 0..1
hex="${selection#\#}"
defaults write -g AppleHighlightColor -string "$(awk -v r=$((16#${hex:0:2})) -v g=$((16#${hex:2:2})) -v b=$((16#${hex:4:2})) \
  'BEGIN { printf "%.6f %.6f %.6f Other", r/255, g/255, b/255 }')"

notify
