#!/bin/bash
# unmacos-settings: the one place that reads, checks and writes your Answers.
#   unmacos-settings list [--long] [GROUP]   every Setting and its value, as TOML (--long: key,
#                                            value and label, tab-separated)
#   unmacos-settings get KEY                 one Setting's value (a list: one item per line)
#   unmacos-settings validate FILE           check an Answers file; exit 1 and say which Setting
#                                            is wrong, warn about keys UnMacOS does not know
#   unmacos-settings write FILE [KEY=VALUE...]
#                                            write the Answers (FILE "-": standard output). Only
#                                            Settings that differ from their default get a value;
#                                            the rest are commented lines with default and help.
#                                            KEY=VALUE changes a Setting first (a list: a,b,c).
#   unmacos-settings migrate FILE            move an Answers file from the old format (flat keys,
#                                            personal = true, a Setting under the group it moved
#                                            from) to the current one, keeping the
#                                            original beside it as FILE.bak. Does nothing to a file
#                                            that is already migrated.
# list, get and write read the Answers from --from FILE (default ~/.config/unmacos/setup.toml).
# Reading the default file migrates it first, so an old file upgrades by itself.
# For Settings the user is asked about at `chezmoi init`, a value chezmoi already holds fills in
# what the Answers leave out; --no-data turns that off.
# The Settings schema (home/.chezmoidata/settings.toml) says what exists, which types and ranges
# are allowed, and the defaults. chezmoi reads the same Answers in .chezmoi.toml.tmpl.
# Runs on macOS's own bash 3.2: install.sh calls it before Homebrew's bash exists.
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

ANSWERS="${UNMACOS_SETUP_FILE:-$HOME/.config/unmacos/setup.toml}"
US=$'\x1f'   # between the fields of a row
RS=$'\x1e'   # between the items of a list

usage() { sed -n '2,21s/^# \{0,1\}//p' "$0"; }
die() { printf 'unmacos-settings: %s\n' "$*" >&2; exit 1; }

# --- Reading ------------------------------------------------------------------------
# One row per Setting, in schema order, in parallel arrays (bash 3.2 has no associative arrays):
#   K key  T type  DEF default  MIN MAX  CH choices  LB label  HP help
#   KIND what the Answers hold (bool, int64, float64, string, slice, map; "" when the value is the
#   default)  VAL value
# Lists are RS-separated, as in the rows chezmoi prints.

read -r -d '' ROWS_TEMPLATE <<'TPL' || true
{{- $us := "\u001f" -}}{{- $rs := "\u001e" -}}
{{- $schema := include (env "SCHEMA") | fromToml -}}
{{- $answers := dict -}}
{{- if and (env "ANSWERS_FILE") (stat (env "ANSWERS_FILE")) }}{{ $answers = include (env "ANSWERS_FILE") | fromToml }}{{ end -}}
{{- $data := dict -}}
{{- if env "WITH_DATA" }}{{ $data = omit . "chezmoi" "settings" }}{{ end -}}
{{- $groups := dict -}}{{- $legacies := dict -}}{{- $known := dict -}}{{- $moved := dict -}}
{{- range $schema.settings -}}
  {{- $_ := set $groups .group true -}}
  {{- $_ = set $known (printf "%s.%s" .group .key) true -}}
  {{- if get . "legacy" }}{{ $_ = set $legacies .legacy true }}{{ end -}}
  {{- with get . "moved_from" }}{{ $_ = set $moved . true }}{{ $_ = set $groups (splitList "." . | first) true }}{{ end -}}
{{- end -}}
{{- range $name, $v := $answers -}}
  {{- if kindIs "map" $v -}}
    {{- if not (hasKey $groups $name) -}}
      {{- printf "U%s[%s] is not a table UnMacOS knows\n" $us $name -}}
    {{- else -}}
      {{- range $key, $_ := $v -}}
        {{- if hasKey $moved (printf "%s.%s" $name $key) -}}
          {{- /* a Setting that has since moved group: the file needs migrating */ -}}
          {{- printf "M%s%s.%s\n" $us $name $key -}}
        {{- else if not (hasKey $known (printf "%s.%s" $name $key)) -}}
          {{- printf "U%s%s.%s is not a Setting UnMacOS knows\n" $us $name $key -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- else -}}
    {{- /* a flat key is the old format: the file needs migrating, whether or not UnMacOS knows the key */ -}}
    {{- printf "M%s%s\n" $us $name -}}
    {{- if and (not (hasKey $legacies $name)) (ne $name "personal") -}}
      {{- printf "U%s%s is not a Setting UnMacOS knows\n" $us $name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $schema.settings -}}
  {{- $legacy := get . "legacy" -}}
  {{- $mg := dict -}}{{- $mk := "" -}}
  {{- with get . "moved_from" }}{{ $mg = get $answers (splitList "." . | first) }}{{ $mk = splitList "." . | last }}{{ end -}}
  {{- $ag := get $answers .group -}}
  {{- $dg := get $data .group -}}
  {{- $v := "" -}}{{- $src := "default" -}}{{- $kind := "" -}}
  {{- if and (kindIs "map" $ag) (hasKey $ag .key) -}}
    {{- $v = index $ag .key -}}{{- $src = "answers" -}}
  {{- else if and $mk (kindIs "map" $mg) (hasKey $mg $mk) -}}
    {{- $v = index $mg $mk -}}{{- $src = "answers" -}}
  {{- else if and $legacy (hasKey $answers $legacy) (not (kindIs "map" (index $answers $legacy))) -}}
    {{- $v = index $answers $legacy -}}{{- $src = "answers" -}}
  {{- else if and (eq .group "apps") (eq .key "groups") (kindIs "bool" (get $answers "personal")) (get $answers "personal") -}}
    {{- /* the old personal = true meant every optional app group */ -}}
    {{- $v = .choices -}}{{- $src = "answers" -}}
  {{- else if and (get . "ask") (kindIs "map" $dg) (hasKey $dg .key) -}}
    {{- $v = index $dg .key -}}{{- $src = "data" -}}
  {{- else -}}
    {{- $v = .default -}}
  {{- end -}}
  {{- if ne $src "default" -}}
    {{- $kind = kindOf $v -}}
    {{- if and (eq $kind "string") (or (contains "\n" $v) (contains "\r" $v)) }}{{ $kind = "multiline" }}{{ end -}}
    {{- if eq $kind "slice" }}{{ range $v }}{{ if not (kindIs "string" .) }}{{ $kind = "slice-mixed" }}{{ end }}{{ end }}{{ end -}}
  {{- end -}}
  {{- if kindIs "slice" $v }}{{ $v = join $rs $v }}{{ end -}}
  {{- $d := .default -}}
  {{- if kindIs "slice" $d }}{{ $d = join $rs $d }}{{ end -}}
  {{- $ch := get . "choices" -}}
  {{- if kindIs "slice" $ch }}{{ $ch = join $rs $ch }}{{ end -}}
  {{- printf "%s\n" (join $us (list "S" (printf "%s.%s" .group .key) .type $d (get . "min") (get . "max") $ch .label .help $src $kind $v "E")) -}}
{{- end -}}
TPL

SCHEMA_FILE=""
N=0
OLD_FORMAT=0   # load found flat keys, the old Answers format
# load FILE WITH_DATA(1/0) REQUIRED(1/0): fill the arrays; unknown-key warnings go to stderr
load() {
  local out tag a b c d e f g h _src j k _end
  [[ -n "$SCHEMA_FILE" ]] || SCHEMA_FILE="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path 2>/dev/null)}/.chezmoidata/settings.toml"
  [[ -r "$SCHEMA_FILE" ]] || die "can't find the Settings schema (is the UnMacOS source set up for chezmoi?)"
  if [[ "$3" == 1 && ! -r "$1" ]]; then die "can't read ${1/#$HOME/~}"; fi
  out="$(SCHEMA="$SCHEMA_FILE" ANSWERS_FILE="$1" WITH_DATA="$( [[ "$2" == 1 ]] && echo 1 || true )" \
    chezmoi execute-template "$ROWS_TEMPLATE" 2>&1)" || die "can't read ${1/#$HOME/~} (is it valid TOML?): ${out##*: }"
  N=0; OLD_FORMAT=0
  while IFS="$US" read -r tag a b c d e f g h _src j k _end; do
    case "$tag" in
      M) OLD_FORMAT=1 ;;
      U) printf 'unmacos-settings: warning: %s (in %s)\n' "$a" "${1/#$HOME/~}" >&2 ;;
      S) K[N]="$a"; T[N]="$b"; DEF[N]="$c"; MIN[N]="$d"; MAX[N]="$e"; CH[N]="$f"; LB[N]="$g"
         HP[N]="$h"; KIND[N]="$j"; VAL[N]="$k"; N=$((N + 1)) ;;
    esac
  done <<< "$out"
  (( N > 0 )) || die "the Settings schema is empty"
  return 0
}

# --- Checking -------------------------------------------------------------------------

kind_name() {
  case "$1" in
    bool) echo "true or false" ;;
    int64) echo "a whole number" ;;
    float64) echo "a number with a decimal point" ;;
    string) echo "text" ;;
    multiline) echo "text on several lines" ;;
    slice) echo "a list" ;;
    slice-mixed) echo "a list with items that are not text" ;;
    map) echo "a table" ;;
    *) echo "$1" ;;
  esac
}
in_set() { [[ "$RS$2$RS" == *"$RS$1$RS"* ]]; }

# problem I: the first thing wrong with Setting I's value, or nothing
problem() {
  local i="$1" want="" item
  [[ -n "${KIND[i]}" ]] || return 0
  case "${T[i]}" in
    bool) want=bool ;;
    int) want=int64 ;;
    enum|string) want=string ;;
    list) want=slice ;;
  esac
  if [[ "${KIND[i]}" != "$want" ]]; then
    case "${T[i]}" in
      list) printf 'must be a list of text, like ["a", "b"], not %s' "$(kind_name "${KIND[i]}")" ;;
      bool) printf 'must be true or false, not %s' "$(kind_name "${KIND[i]}")" ;;
      *)    printf 'must be %s, not %s' "$(kind_name "$want")" "$(kind_name "${KIND[i]}")" ;;
    esac
    return 0
  fi
  case "${T[i]}" in
    int)
      if [[ -n "${MIN[i]}" ]] && (( VAL[i] < MIN[i] )); then
        printf '%s is below the minimum %s' "${VAL[i]}" "${MIN[i]}"
      elif [[ -n "${MAX[i]}" ]] && (( VAL[i] > MAX[i] )); then
        printf '%s is above the maximum %s' "${VAL[i]}" "${MAX[i]}"
      fi ;;
    enum)
      in_set "${VAL[i]}" "${CH[i]}" || printf '"%s" is not one of: %s' "${VAL[i]}" "${CH[i]//$RS/, }" ;;
    list)
      if [[ -n "${CH[i]}" && -n "${VAL[i]}" ]]; then
        local IFS="$RS"
        for item in ${VAL[i]}; do
          in_set "$item" "${CH[i]}" || { printf '"%s" is not one of: %s' "$item" "${CH[i]//$RS/, }"; return 0; }
        done
      fi ;;
  esac
  return 0
}

# check_all: print one line per wrong Setting; the number wrong is the exit status (0 = fine)
check_all() {
  local i p bad=0
  for ((i = 0; i < N; i++)); do
    p="$(problem "$i")"
    if [[ -n "$p" ]]; then printf 'unmacos-settings: %s: %s\n' "${K[i]}" "$p" >&2; bad=$((bad + 1)); fi
  done
  (( bad == 0 ))
}

# --- Values ---------------------------------------------------------------------------

# index_of KEY: set IDX to the Setting's row, or fail naming it
index_of() {
  local i
  for ((i = 0; i < N; i++)); do
    if [[ "${K[i]}" == "$1" ]]; then IDX=$i; return 0; fi
  done
  die "no Setting called '$1' (unmacos-settings list shows them all)"
}

tq() {  # a TOML string
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"; s="${s//$'\t'/\\t}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"
  printf '"%s"' "$s"
}
tl() {  # an RS-separated list as a TOML array
  local out="" item IFS="$RS"
  for item in $1; do out="$out${out:+, }$(tq "$item")"; done
  printf '[%s]' "$out"
}
toml_value() {  # Setting I's value as TOML
  case "${T[$1]}" in
    bool|int) printf '%s' "${VAL[$1]}" ;;
    list) tl "${VAL[$1]}" ;;
    *) tq "${VAL[$1]}" ;;
  esac
}

# assign KEY RAW: change a Setting's value from text typed on the command line
assign() {
  local key="$1" raw="$2"
  index_of "$key"
  case "${T[IDX]}" in
    bool) if [[ "$raw" == true || "$raw" == false ]]; then KIND[IDX]=bool; else KIND[IDX]=string; fi ;;
    int) if [[ "$raw" =~ ^-?[0-9]+$ ]]; then KIND[IDX]=int64; else KIND[IDX]=string; fi ;;
    list) KIND[IDX]=slice; raw="${raw//,/$RS}" ;;
    *) KIND[IDX]=string; [[ "$raw" != *$'\n'* ]] || KIND[IDX]=multiline ;;
  esac
  VAL[IDX]="$raw"
}

# --- Writing --------------------------------------------------------------------------------

emit_answers() {
  local g i groups="" key prefix
  printf '# UnMacOS setup: your answers to unmacos-setup (run it again to change them).\n'
  printf '# Only the Settings you changed have a value; the others are commented out with their default.\n'
  printf '# Copy this file to another Mac and run: unmacos-setup --import FILE\n'
  # shellcheck disable=SC2016 # the $(curl …) is for the reader to run
  printf '# or, on a fresh Mac: UNMACOS_SETUP=FILE bash -c "$(curl -fsSL https://raw.githubusercontent.com/shrujancheruku/unmacos/main/install.sh)"\n'
  for ((i = 0; i < N; i++)); do
    g="${K[i]%%.*}"
    [[ " $groups " == *" $g "* ]] || groups="$groups${groups:+ }$g"
  done
  for g in $groups; do
    printf '\n[%s]\n' "$g"
    for ((i = 0; i < N; i++)); do
      [[ "${K[i]%%.*}" == "$g" ]] || continue
      key="${K[i]#*.}"; prefix=""
      [[ "${VAL[i]}" == "${DEF[i]}" ]] && prefix="# "
      printf '%s%s = %s   # %s\n' "$prefix" "$key" "$(toml_value "$i")" "${HP[i]}"
    done
  done
}

# write_file PATH: the Answers as emit_answers prints them, replacing PATH in one step.
# Every step is checked by hand: callers may run it where `set -e` does not apply.
write_file() {
  local tmp="$1.tmp.$$"
  mkdir -p "$(dirname "$1")" || return 1
  if ! { emit_answers > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$1"; }; then   # 600: git name and email are in it
    rm -f "$tmp"
    return 1
  fi
}

# --- Migrating -------------------------------------------------------------------------------

# migrate_file FILE: if FILE is in the old format, keep a copy of it (FILE.bak, or .bak.2, .bak.3 …
# when earlier ones exist) and rewrite it in the grouped format with the same values. A file
# already in the grouped format is left alone. Fails, changing nothing, if a value is wrong or
# the folder can't be written to.
migrate_file() {
  local f="$1" bak n=1
  load "$f" 0 1
  (( OLD_FORMAT )) || return 0
  check_all || { printf 'unmacos-settings: not migrating %s until that is fixed\n' "${f/#$HOME/~}" >&2; return 1; }
  bak="$f.bak"
  while [[ -e "$bak" ]]; do n=$((n + 1)); bak="$f.bak.$n"; done
  if ! { cp -p "$f" "$bak" && chmod 600 "$bak"; }; then
    rm -f "$bak"
    printf 'unmacos-settings: could not keep a backup of %s, so it is not migrated\n' "${f/#$HOME/~}" >&2
    return 1
  fi
  if ! write_file "$f"; then
    printf 'unmacos-settings: could not rewrite %s; the original is still there\n' "${f/#$HOME/~}" >&2
    return 1
  fi
  printf 'unmacos-settings: migrated %s to the new format; the original is kept as %s\n' \
    "${f/#$HOME/~}" "${bak/#$HOME/~}" >&2
}

# auto_migrate: the first read of the real Answers file upgrades an old one, so nobody has to run
# migrate. Anything wrong (a bad value, a folder that can't be written) leaves the file as it is
# and the command carries on with it; the command's own checks report a bad value.
auto_migrate() {
  [[ "$from" == "$ANSWERS" && -f "$from" ]] && (( OLD_FORMAT )) || return 0
  check_all 2>/dev/null || return 0
  if ( migrate_file "$from" ); then load "$from" "$with_data" 0; fi
}

# --- Main -------------------------------------------------------------------------------

cmd="${1:-}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  list|get|write|validate|migrate) ;;
  ""|-h|--help|help) usage; [[ -n "$cmd" ]] || exit 2; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

from="$ANSWERS"; with_data=1; long=0; POS=()
while (( $# )); do
  case "$1" in
    --from)    from="${2:?--from needs a file}"; shift ;;
    --data)    with_data=1 ;;
    --no-data) with_data=0 ;;
    --long)    long=1 ;;
    -h|--help) usage; exit 0 ;;
    -) POS[${#POS[@]}]="$1" ;;
    -*) usage >&2; exit 2 ;;
    *) POS[${#POS[@]}]="$1" ;;
  esac
  shift
done
npos=${#POS[@]}

case "$cmd" in
  migrate)
    (( npos == 1 )) || { usage >&2; exit 2; }
    migrate_file "${POS[0]}" || exit 1 ;;
  validate)
    (( npos == 1 )) || { usage >&2; exit 2; }
    load "${POS[0]}" 0 1
    check_all || exit 1 ;;
  list)
    (( npos <= 1 )) || { usage >&2; exit 2; }
    load "$from" "$with_data" 0
    auto_migrate
    check_all || exit 1
    for ((i = 0; i < N; i++)); do
      [[ $npos -eq 0 || "${K[i]%%.*}" == "${POS[0]}" ]] || continue
      if (( long )); then printf '%s\t%s\t%s\n' "${K[i]}" "${VAL[i]//$RS/,}" "${LB[i]}"
      else printf '%s = %s\n' "${K[i]}" "$(toml_value "$i")"; fi
    done ;;
  get)
    (( npos == 1 )) || { usage >&2; exit 2; }
    load "$from" "$with_data" 0
    auto_migrate
    check_all || exit 1
    index_of "${POS[0]}"
    if [[ "${T[IDX]}" == list ]]; then
      [[ -z "${VAL[IDX]}" ]] || printf '%s\n' "${VAL[IDX]//$RS/$'\n'}"
    else
      printf '%s\n' "${VAL[IDX]}"
    fi ;;
  write)
    (( npos >= 1 )) || { usage >&2; exit 2; }
    load "$from" "$with_data" 0
    auto_migrate
    for ((i = 1; i < npos; i++)); do
      [[ "${POS[i]}" == *=* ]] || die "'${POS[i]}' is not KEY=VALUE"
      assign "${POS[i]%%=*}" "${POS[i]#*=}"
    done
    check_all || exit 1
    if [[ "${POS[0]}" == - ]]; then
      emit_answers
    else
      write_file "${POS[0]}"
    fi ;;
esac
