#!/usr/bin/env bash
# UnMacOS theme switcher, kept because menus and docs call it.
#   unmacos-theme-render [theme]      default: current theme, else tokyo-night
#   unmacos-theme-render --list
# Sets the live Theme (~/.local/state/unmacos/theme.name), renders the Look into
# ~/.local/state/unmacos/theme/ and live-reloads what can be reloaded, all through
# unmacos-look. Apps read only from that state directory, so switching themes is
# just re-running this. UNMACOS_NO_RELOAD=1 renders without reloading.
set -euo pipefail

SHARE="${UNMACOS_SHARE:-$HOME/.local/share/unmacos}"
STATE="${UNMACOS_STATE:-$HOME/.local/state/unmacos}"
LOOK="${UNMACOS_LOOK:-$(dirname "$0")/unmacos-look}"
OUT="$STATE/theme"

if [[ "${1:-}" == "--list" ]]; then
  ls "$SHARE/themes"
  exit 0
fi

theme="${1:-$(cat "$STATE/theme.name" 2>/dev/null || echo tokyo-night)}"
[[ -f "$SHARE/themes/$theme/colors.toml" ]] || { echo "unmacos: no theme '$theme' (try --list)" >&2; exit 1; }

UNMACOS_THEME="$theme" bash "$LOOK" render "$OUT"
mkdir -p "$STATE"
echo "$theme" > "$STATE/theme.name"
echo "unmacos: theme '$theme' rendered to $OUT"
exec bash "$LOOK" reload "$OUT"
