#!/usr/bin/env bash
# UnMacOS theme renderer (Omarchy-style).
#   unmacos-theme-render [theme]      default: current theme, else tokyo-night
#   unmacos-theme-render --list
# Renders ~/.local/share/unmacos/templates/*.tpl with the theme's colors.toml
# into ~/.local/state/unmacos/theme/, lets the theme's own files override any
# template, then live-reloads what can be reloaded. Apps read only from that
# state directory, so switching themes is just re-running this.
set -euo pipefail
# What unmacos-setup told UnMacOS to leave alone (UNMACOS_KEEP_*)
[[ -r "$HOME/.config/unmacos/prefs.sh" ]] && . "$HOME/.config/unmacos/prefs.sh"

SHARE="${UNMACOS_SHARE:-$HOME/.local/share/unmacos}"
STATE="${UNMACOS_STATE:-$HOME/.local/state/unmacos}"
OUT="$STATE/theme"

if [[ "${1:-}" == "--list" ]]; then
  ls "$SHARE/themes"
  exit 0
fi

theme="${1:-$(cat "$STATE/theme.name" 2>/dev/null || echo tokyo-night)}"
src="$SHARE/themes/$theme"
[[ -f "$src/colors.toml" ]] || { echo "unmacos: no theme '$theme' (try --list)" >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Build a sed script from colors.toml: {{ key }}, {{ key_strip }} (no #), {{ key_rgb }} (r,g,b)
: > "$tmp/colors.sed"
while IFS='=' read -r key val; do
  key="${key//[[:space:]]/}"
  [[ -z "$key" || "$key" == \#* || -z "$val" ]] && continue
  val="${val#"${val%%[![:space:]]*}"}"; val="${val%\"*}"; val="${val#\"}"
  printf 's|{{ %s }}|%s|g\n' "$key" "$val" >> "$tmp/colors.sed"
  if [[ "$val" =~ ^#([0-9a-fA-F]{6})$ ]]; then
    hex="${BASH_REMATCH[1]}"
    printf 's|{{ %s_strip }}|%s|g\n' "$key" "$hex" >> "$tmp/colors.sed"
    printf 's|{{ %s_rgb }}|%d,%d,%d|g\n' "$key" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}" >> "$tmp/colors.sed"
  fi
done < "$src/colors.toml"
# {{ mode_is_dark }}: 1 for dark themes, 0 for light (Dark Reader's theme mode)
if grep -q '^mode *= *"light"' "$src/colors.toml"; then mode_is_dark=0; else mode_is_dark=1; fi
printf 's|{{ mode_is_dark }}|%s|g\n' "$mode_is_dark" >> "$tmp/colors.sed"

mkdir -p "$tmp/out"
for tpl in "$SHARE"/templates/*.tpl; do
  name="$(basename "$tpl" .tpl)"
  sed -f "$tmp/colors.sed" "$tpl" > "$tmp/out/$name"
done
# Theme-provided files win over rendered templates
for f in "$src"/*; do
  [[ "$(basename "$f")" == "colors.toml" ]] && continue
  cp "$f" "$tmp/out/"
done
cp "$src/colors.toml" "$tmp/out/colors.toml"

left="$(grep -l '{{ ' "$tmp"/out/* 2>/dev/null | grep -v '/colors.toml$' || true)"
[[ -n "$left" ]] && echo "unmacos: warning, unrendered keys in: $(echo "$left" | xargs -n1 basename | tr '\n' ' ')" >&2

mkdir -p "$STATE"
rm -rf "$OUT"
mv "$tmp/out" "$OUT"
echo "$theme" > "$STATE/theme.name"
echo "unmacos: theme '$theme' rendered to $OUT"

# Firefox (Pywalfox) reads pywal's colors file. Link it to ours, unless real
# pywal owns it. Pywalfox's built-in templates read fixed slots and expect
# color0 to be dark (dark mode: color10 = icons and highlights; light mode:
# color0 = text, color7 = background), so light themes get their own layout.
# Its defaults brighten color0 for the toolbar and URL bar (x2.25 and x2.85),
# far too light, so unmacos.cfg points Pywalfox's palette template at slots
# holding the theme's own surfaces: frame color8 = dark_background, toolbar
# color0 (light: color15) = background, URL bar color7 = lighter_background.
wal="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.json"
if [[ ! -e "$wal" || -L "$wal" ]]; then
  mkdir -p "$(dirname "$wal")"
  pywal="pywal-colors.json"; [[ "$mode_is_dark" == 0 ]] && pywal="pywal-colors-light.json"
  ln -sfn "$OUT/$pywal" "$wal"
fi

[[ "${UNMACOS_NO_RELOAD:-}" == 1 ]] && exit 0

# --- Live reload (best effort) ---
# The theme picker runs in a popup terminal that closes as soon as this script
# exits, which sends SIGHUP and kills the background jobs below (the wallpaper)
# before they start. Ignore it here so they inherit that and outlive the popup.
trap '' HUP
mode="$(awk -F'"' '/^mode/ {print $2}' "$src/colors.toml")"
osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $([[ "$mode" == light ]] && echo false || echo true)" >/dev/null 2>&1 || true
# Accent and highlight colours (dialogs, buttons, selection). UNMACOS_KEEP_ACCENT=1 skips it.
[[ "${UNMACOS_KEEP_ACCENT:-}" != 1 && -x "$HOME/.local/bin/unmacos-accent" ]] && "$HOME/.local/bin/unmacos-accent" "$theme" >/dev/null 2>&1 || true
pgrep -xq sketchybar && sketchybar --reload >/dev/null 2>&1 || true
pgrep -xq borders && [[ -x "$HOME/.config/borders/bordersrc" ]] && "$HOME/.config/borders/bordersrc" >/dev/null 2>&1 &
pgrep -xq tmux && tmux source-file "$OUT/tmux.conf" >/dev/null 2>&1 || true
# Ghostty reloads its config on SIGUSR2. pgrep/pkill can't see the Ghostty app
# process, so find it with ps.
ghostty_pids="$(ps -axo pid=,ucomm= | awk '$2 == "ghostty" {print $1}')"
[[ -n "$ghostty_pids" ]] && kill -USR2 $ghostty_pids >/dev/null 2>&1 || true
# btop rewrites btop.conf on exit, so a theme picked in btop's own menu sticks
# and hides ours. Point it back at the rendered theme, then SIGUSR2 reloads it.
btop_conf="$HOME/.config/btop/btop.conf"
[[ -f "$btop_conf" ]] && sed -i '' 's/^color_theme = .*/color_theme = "unmacos"/' "$btop_conf"
pkill -USR2 -x btop >/dev/null 2>&1 || true
# Firefox: Pywalfox's extension rereads the colors on `pywalfox update`. Pin
# its mode to the theme's first: in "auto" it picks light or dark by time of
# day, so a dark theme turned light during the day.
if [[ -x "$HOME/.local/bin/pywalfox" ]]; then
  "$HOME/.local/bin/pywalfox" "$([[ "$mode" == light ]] && echo light || echo dark)" >/dev/null 2>&1 || true
  "$HOME/.local/bin/pywalfox" update >/dev/null 2>&1 || true
fi
# Firefox pages: Dark Reader can't be driven from outside; import
# $OUT/darkreader.json in its settings to recolour pages for the new theme.
# Neovim reloads itself: lua/plugins/unmacos-theme.lua watches $OUT
# Orca: push the palette into its settings over its runtime socket (live).
# UNMACOS_KEEP_ORCA=1 leaves Orca's theme alone.
if [[ "${UNMACOS_KEEP_ORCA:-}" != 1 && -x "$HOME/.local/bin/unmacos-orca-recolor" ]] && pgrep -xq Orca; then
  "$HOME/.local/bin/unmacos-orca-recolor" </dev/null >/dev/null 2>&1 &
fi
# Spotify (Spicetify): bake the new color.ini into Spotify's colors.css, then
# swap it into the open Spotify over DevTools (unmacos-spotify-recolor: live,
# playback untouched). That needs Spotify launched with the debug port, so if
# it wasn't (opened from the Dock), quit and reopen it with the port, resuming
# playback; later switches are then live. `spicetify restart` can't do this: it
# quits Spotify but doesn't relaunch it on macOS.
if [[ "${UNMACOS_KEEP_SPOTIFY:-}" != 1 ]] && command -v spicetify >/dev/null 2>&1 \
   && [[ "$(spicetify config current_theme 2>/dev/null)" == UnMacOS ]]; then
  (
    spicetify -q -n refresh || exit 0
    pgrep -xq Spotify || exit 0
    "$HOME/.local/bin/unmacos-spotify-recolor" && exit 0
    spot() { osascript -e "if application \"Spotify\" is running then tell application \"Spotify\" to $1" 2>/dev/null || true; }
    playing="$(spot 'player state as string')"
    osascript -e 'tell application "Spotify" to quit' 2>/dev/null || pkill -x Spotify
    for _ in $(seq 40); do pgrep -xq Spotify || break; sleep 0.25; done
    pgrep -xq Spotify && { pkill -x Spotify; sleep 1; }
    "$HOME/.local/bin/unmacos-spotify" -g
    if [[ "$playing" == playing ]]; then
      # Wait for the relaunched player to come up paused, then press play
      for _ in $(seq 40); do
        sleep 0.5
        state="$(spot 'player state as string')"
        [[ "$state" == playing ]] && break
        [[ "$state" == paused ]] && spot play >/dev/null
      done
    fi
  ) </dev/null >/dev/null 2>&1 &
fi
# The theme's wallpaper (downloaded on first use, so in the background).
# UNMACOS_KEEP_WALLPAPER=1 leaves the wallpaper alone.
if [[ "${UNMACOS_KEEP_WALLPAPER:-}" != 1 && -x "$HOME/.local/bin/unmacos-wallpaper" ]]; then
  ( "$HOME/.local/bin/unmacos-wallpaper" theme "$theme" </dev/null >/dev/null 2>&1 & )
fi
exit 0
