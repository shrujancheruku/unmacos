#!/usr/bin/env bash
# UnMacOS theme switcher, kept because menus and docs call it.
#   unmacos-theme-render [theme]      default: the current Theme
#   unmacos-theme-render --list
# Sets the Theme, renders the Look into ~/.local/state/unmacos/theme/ (unmacos-look render)
# and live-reloads apps (unmacos-look reload). UNMACOS_NO_RELOAD=1 skips the reload.
set -euo pipefail
SHARE="${UNMACOS_SHARE:-$HOME/.local/share/unmacos}"
STATE="${UNMACOS_STATE:-$HOME/.local/state/unmacos}"
look="$(dirname "$0")/unmacos-look"

[[ "${1:-}" == "--list" ]] && exec "$look" --list

if [[ -n "${1:-}" ]]; then
  theme="$1"
  [[ -f "$SHARE/themes/$theme/colors.toml" ]] || { echo "unmacos: no theme '$theme' (try --list)" >&2; exit 1; }
  mkdir -p "$STATE"
  old="$(cat "$STATE/theme.name" 2>/dev/null || true)"
  echo "$theme" > "$STATE/theme.name"
  if ! "$look" render "$STATE/theme"; then
    # Put the last pick back, so the Theme name matches what apps show
    if [[ -n "$old" ]]; then echo "$old" > "$STATE/theme.name"; else rm -f "$STATE/theme.name"; fi
    exit 1
  fi
else
  "$look" render "$STATE/theme"
fi
echo "unmacos: theme '$(cat "$STATE/theme.name" 2>/dev/null || echo "${theme:-}")' rendered to $STATE/theme"
"$look" reload
