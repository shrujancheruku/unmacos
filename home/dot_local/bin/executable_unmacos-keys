#!/bin/bash
# UnMacOS: keyboard shortcut cheatsheet, like Omarchy's SUPER + K.
#   unmacos-keys          show every shortcut in columns. Any key closes, / searches
#   unmacos-keys --list   section<TAB>keys<TAB>description, one per line
# Built from ~/.config/rift/config.toml: sections are "# --- Title ---" lines,
# descriptions the "#: text" after each binding ("#: [label] text" for a group,
# "#:-" to hide). Bindings without one still show, with their Rift action.
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
CONFIG="${UNMACOS_RIFT_CONFIG:-$HOME/.config/rift/config.toml}"

list() {
  awk '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    # Modifiers always in the order Alt, Ctrl, Shift, Cmd; symbols for key names
    function pretty(k,   n, p, i, m, rest, out) {
      gsub(/Slash/, "/", k); gsub(/Minus/, "-", k); gsub(/Equal/, "=", k)
      gsub(/Period/, ".", k); gsub(/Escape/, "Esc", k)
      n = split(k, p, / \+ /); rest = ""
      for (i = 1; i <= n; i++) {
        if (p[i] ~ /^(Alt|Ctrl|Shift|Cmd)$/) m[p[i]] = 1
        else rest = rest (rest == "" ? "" : " + ") p[i]
      }
      out = ""
      if ("Alt" in m) out = out "Alt + "
      if ("Ctrl" in m) out = out "Ctrl + "
      if ("Shift" in m) out = out "Shift + "
      if ("Cmd" in m) out = out "Cmd + "
      return out rest
    }
    /^\[keys\]/ { on = 1; next }
    !on { next }
    /^# --- .* ---[ \t]*$/ { sec = $0; sub(/^# --- /, "", sec); sub(/ ---[ \t]*$/, "", sec); next }
    /^"/ {
      line = $0
      key = line; sub(/^"/, "", key); sub(/".*$/, "", key)
      i = index(line, "#:")
      if (i) {
        desc = trim(substr(line, i + 2))
        if (desc == "-") next
        if (substr(desc, 1, 1) == "[" && (j = index(desc, "]"))) {
          key = substr(desc, 2, j - 2); desc = trim(substr(desc, j + 1))
        }
      } else {
        desc = line; sub(/^"[^"]*"[ \t]*=[ \t]*/, "", desc); sub(/[ \t]+#.*$/, "", desc)
      }
      print (sec == "" ? "Other" : sec) "\t" pretty(key) "\t" desc
    }
  ' "$CONFIG"
}

render() {
  local cols="$1"
  list | LC_ALL=C awk -F'\t' -v W="$cols" '
    # display width: count every byte except UTF-8 continuation bytes, so "1–5" is 3
    function w(s,   i, c, n) {
      for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (!(c >= "\200" && c < "\300")) n++ }
      return n + 0
    }
    function pad(s, n) { return s sprintf("%" (n - w(s) > 0 ? n - w(s) : 0) "s", "") }
    {
      if ($1 != last) { ns++; title[ns] = $1; last = $1 }
      n[ns]++; k[ns, n[ns]] = $2; d[ns, n[ns]] = $3
      if (w($2) > kw) kw = w($2)
      if (w($3) > dw) dw = w($3)
      total++
    }
    END {
      gap = 4; cw = kw + 2 + dw
      nc = int((W - 4 + gap) / (cw + gap)); if (nc < 1) nc = 1
      # lines per section: title + entries + blank
      for (s = 1; s <= ns; s++) { h[s] = n[s] + 2; all += h[s] }
      target = int((all + nc - 1) / nc)
      c = 1
      for (s = 1; s <= ns; s++) {
        if (rows[c] > 0 && rows[c] + h[s] - 1 > target && c < nc) c++
        r = rows[c]
        out[c, ++r] = sprintf("\033[1;35m%s\033[0m", title[s]); vis[c, r] = w(title[s])
        for (e = 1; e <= n[s]; e++) {
          out[c, ++r] = sprintf("\033[1;34m%s\033[0m  %s", pad(k[s, e], kw), d[s, e])
          vis[c, r] = kw + 2 + w(d[s, e])
        }
        out[c, ++r] = ""; vis[c, r] = 0
        rows[c] = r
      }
      used = 0; for (i = 1; i <= c; i++) if (rows[i] > used) used = rows[i]
      width = c * cw + (c - 1) * gap
      left = int((W - width) / 2); if (left < 2) left = 2
      ind = sprintf("%" left "s", "")
      head = "Keyboard shortcuts"
      printf "\n%s\033[1m%s\033[0m\033[2m   Alt does what SUPER does in Omarchy\033[0m\n\n", ind, head
      for (r = 1; r < used; r++) {
        line = ind
        for (i = 1; i <= c; i++) {
          cell = ((i, r) in out) ? out[i, r] : ""
          vw = ((i, r) in vis) ? vis[i, r] : 0
          line = line cell
          if (i < c) line = line sprintf("%" (cw - vw + gap) "s", "")
        }
        sub(/[ ]+$/, "", line); print line
      }
      printf "%s\033[2m/ search   ·   any other key closes\033[0m\n", ind
    }
  '
}

if [[ "${1:-}" == --list ]]; then list; exit; fi

draw() {
  local cols lines size
  # stty reads the terminal itself; tput inside $(...) only sees a pipe and says 80
  size="$(stty size </dev/tty 2>/dev/null)" || size=""
  lines="${size% *}"; cols="${size#* }"
  [[ -n "$size" ]] || { lines="${LINES:-40}"; cols="${COLUMNS:-120}"; }
  sheet="$(render "$cols")"
  fits=1; (( $(printf '%s\n' "$sheet" | wc -l) < lines )) || fits=0
}

if [[ ! -t 0 || ! -t 1 ]]; then draw; printf '%s\n' "$sheet"; exit; fi

# Rift sizes the popup just after it opens: give it a moment, then measure
sleep 0.3
draw
if (( ! fits )); then
  # Too small a window for everything at once: scroll instead
  printf '%s\n' "$sheet" | less -R -P '↑↓ scroll  ·  / find  ·  q close'
  exit
fi

tput civis 2>/dev/null; trap 'tput cnorm 2>/dev/null' EXIT
show() { clear; printf '%s' "$sheet"; }
trap 'draw; show' WINCH
show
key=""
until IFS= read -rsn1 -t 1 key; do :; done
if [[ "$key" == / ]]; then
  trap - WINCH; tput cnorm 2>/dev/null; clear
  exec unmacos-menu keybinds
fi
