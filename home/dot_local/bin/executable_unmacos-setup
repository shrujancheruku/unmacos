#!/bin/bash
# UnMacOS setup wizard: everything UnMacOS can do differently, asked once.
#   unmacos-setup                  ask, save, then apply (chezmoi init --apply)
#   unmacos-setup --yes            no questions: keep the saved answers (or the defaults)
#   unmacos-setup --no-apply       only save the answers (install.sh applies them itself)
#   unmacos-setup --export [FILE]  write your answers, with today's theme and weather place,
#                                  to FILE (default: stdout), to rebuild another Mac the same way
#   unmacos-setup --import FILE    use FILE's answers (no questions), save and apply
#   unmacos-setup --checklist      the steps macOS won't let a script do, and which are done
# Answers live in ~/.config/unmacos/setup.toml (git name and email included: keep exports
# somewhere private). unmacos-settings reads, checks and writes them; chezmoi reads them through
# .chezmoi.toml.tmpl.
# Runs on macOS's own bash 3.2: install.sh calls it before Homebrew's bash exists.
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

SETUP="${UNMACOS_SETUP_FILE:-$HOME/.config/unmacos/setup.toml}"
STATE="${UNMACOS_STATE:-$HOME/.local/state/unmacos}"
REPO="$(chezmoi execute-template '{{ .chezmoi.workingTree }}' 2>/dev/null || true)"
[[ -d "$REPO/brew" ]] || REPO="$HOME/.local/share/chezmoi"

SEP=" — "   # between an option's name and its description

usage() { sed -n '2,12s/^# \{0,1\}//p' "$0"; }
die() { printf 'unmacos-setup: %s\n' "$*" >&2; exit 1; }

# --- Answers -----------------------------------------------------------------
# Every read and write of the Answers goes through unmacos-settings. Lists are "|"-separated here.

# It sits next to this script in the source (install.sh runs it from there, before chezmoi has
# applied anything), or on PATH once applied.
HERE="$(cd "$(dirname "$0")" && pwd)"
SETTINGS=""
for c in "$HERE/unmacos-settings" "$HERE/executable_unmacos-settings"; do
  [[ -r "$c" ]] && { SETTINGS="$c"; break; }
done
[[ -n "$SETTINGS" ]] || SETTINGS="$(command -v unmacos-settings || true)"
[[ -n "$SETTINGS" ]] || die "can't find unmacos-settings"
settings() { /bin/bash "$SETTINGS" "$@"; }

FROM="$SETUP"          # the Answers being read
DATA="--data"          # --no-data: ignore what chezmoi was asked at init (an import's own Answers)
SET=()                 # KEY=VALUE changes made on top of FROM
sget() { settings get "$DATA" --from "$FROM" "$1"; }
sgetl() { sget "$1" | paste -s -d'|' -; }   # a list as a|b|c
put() { SET[${#SET[@]}]="$1=$2"; }
swrite() { settings write "$1" "$DATA" --from "$FROM" ${SET[@]+"${SET[@]}"}; }
is_true() { [[ "$(sget "$1")" == true ]]; }

# What this Mac uses right now (the menus change these, not setup.toml)
LIVE_THEME=""; LIVE_WEATHER=""
load_live() {
  local w
  LIVE_THEME="$(cat "$STATE/theme.name" 2>/dev/null || true)"
  [[ -z "$LIVE_THEME" ]] || put look.theme "$LIVE_THEME"
  if [[ -e "$STATE/weather.location" ]]; then
    w="$(cat "$STATE/weather.location")"; LIVE_WEATHER="${w:-auto}"
    put bar.weather "$LIVE_WEATHER"
  fi
  return 0
}

# Git's own name and email stand in until the Answers have one
load_git() {
  local v
  if [[ -z "$(sget git.name)" ]]; then v="$(git config --global user.name 2>/dev/null || true)"; [[ -z "$v" ]] || put git.name "$v"; fi
  if [[ -z "$(sget git.email)" ]]; then v="$(git config --global user.email 2>/dev/null || true)"; [[ -z "$v" ]] || put git.email "$v"; fi
  return 0
}

save() {
  local new="$SETUP.new"
  mkdir -p "$(dirname "$SETUP")"
  swrite "$new" || { rm -f "$new"; exit 1; }
  # check what is about to be saved
  FROM="$new"; DATA="--no-data"; SET=()
  local g theme name email
  for g in $(sgetl apps.groups | tr '|' ' '); do
    [[ -f "$REPO/brew/$g.Brewfile" ]] || { rm -f "$new"; die "unknown app group '$g' (have: $(groups | tr '\n' ' '))"; }
  done
  theme="$(sget look.theme)"
  [[ -d "$REPO/home/dot_local/share/unmacos/themes/$theme" ]] || { rm -f "$new"; die "unknown theme '$theme'"; }
  name="$(sget git.name)"; email="$(sget git.email)"
  [[ -n "$name" && -n "$email" ]] || { rm -f "$new"; die "git name and email are needed (run unmacos-setup in a terminal)"; }
  mv "$new" "$SETUP"
  chmod 600 "$SETUP"
  FROM="$SETUP"
  echo "Saved ${SETUP/#$HOME/~}"
}

# --- Optional apps -------------------------------------------------------------

groups() { local f; for f in "$REPO"/brew/*.Brewfile; do basename "$f" .Brewfile; done; }
group_about() { sed -n '1s/^# *//p' "$REPO/brew/$1.Brewfile"; }
# group_items GROUP: "id — description" per app (id = name after the tap, as in apps_skip)
group_items() {
  awk -v sep="$SEP" '/^(brew|cask|mas) "/ {
      split($0, q, "\""); id = q[2]; sub(/.*\//, "", id)
      d = $0; if (sub(/.*# */, "", d) == 0) d = $1
      if ($1 == "mas") d = d " (App Store)"
      print id sep d }' "$REPO/brew/$1.Brewfile"
}
in_list() { [[ "|$2|" == *"|$1|"* ]]; }
nocomma() { printf '%s' "${1//, / · }"; }   # gum's --selected is comma-separated

# --- Questions -------------------------------------------------------------------

have_ui() { [[ -t 0 && -t 1 ]] && command -v gum >/dev/null; }

# pick HEADER SELECTED-LABELS(|) LABELS...: chosen labels, one per line
pick() {
  local header="$1" selected="$2"; shift 2
  local sel="" l
  for l in "$@"; do in_list "$l" "$selected" && sel="$sel${sel:+,}$l"; done
  printf '%s\n' "$@" | gum choose --no-limit --height 14 --header "$header" \
    ${sel:+--selected="$sel"} || return 1
}

# pick_group GROUP HEADER: tick the true/false Settings of one table, labelled as the schema does
pick_group() {
  local group="$1" header="$2" k v l chosen sel=""
  local keys=() labels=() i
  while IFS=$'\t' read -r k v l; do
    keys[${#keys[@]}]="$k"; labels[${#labels[@]}]="$l"
    [[ "$v" == true ]] && sel="$sel|$l"
  done < <(settings list --long "$DATA" --from "$FROM" "$group")
  chosen="$(pick "$header" "$sel" "${labels[@]}")"
  for ((i = 0; i < ${#keys[@]}; i++)); do
    if printf '%s\n' "$chosen" | grep -qxF -- "${labels[i]}"; then put "${keys[i]}" true; else put "${keys[i]}" false; fi
  done
}

ask() {
  local l k chosen labels sel g items skip_now
  local a_theme a_apps a_apps_skip a_weather a_1p

  gum style --border rounded --padding "0 2" --margin "1 0" --border-foreground 4 \
    "UnMacOS setup" "x or Tab ticks and unticks, Enter goes on. Run unmacos-setup again any time."

  put git.name "$(gum input --header "Your name, for git commits" --value "$(sget git.name)" --placeholder "Ada Lovelace")"
  put git.email "$(gum input --header "Your email, for git commits (stays on this Mac)" --value "$(sget git.email)" --placeholder "ada@example.com")"

  a_1p=false
  if gum confirm "Read secrets from 1Password? (spotify_player's client ID; needs the 1Password app and CLI)" \
       --default="$(sget onepassword.enabled)"; then a_1p=true; fi
  put onepassword.enabled "$a_1p"

  a_theme="${LIVE_THEME:-$(sget look.theme)}"
  put look.theme "$(find "$REPO/home/dot_local/share/unmacos/themes" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort \
    | gum choose --height 14 --header "Theme (switch any time: Alt + Ctrl + Shift + Space)" --selected="$a_theme")"

  # App groups
  a_apps="$(sgetl apps.groups)"; a_apps_skip="$(sgetl apps.skip)"
  labels=(); sel=""
  for g in $(groups); do
    l="$g$SEP$(nocomma "$(group_about "$g")")"; labels+=("$l")
    in_list "$g" "$a_apps" && sel="$sel|$l"
  done
  chosen="$(pick "Extra apps to install (the desktop and terminal tools always are)" "$sel" "${labels[@]}")"
  a_apps=""
  while IFS= read -r l; do [[ -n "$l" ]] && a_apps="$a_apps${a_apps:+|}${l%%"$SEP"*}"; done <<< "$chosen"

  if [[ -n "$a_apps" ]] && gum confirm "Leave out some apps in those groups?" --default="$([[ -n "$a_apps_skip" ]] && echo true || echo false)"; then
    skip_now=""
    local IFS_was="$IFS"; IFS='|'
    for g in $a_apps; do
      IFS="$IFS_was"
      items=(); sel=""
      while IFS= read -r l; do
        l="$(nocomma "$l")"; items+=("$l")
        in_list "${l%%"$SEP"*}" "$a_apps_skip" || sel="$sel|$l"
      done < <(group_items "$g")
      chosen="$(pick "$g: untick what you don't want" "$sel" "${items[@]}")"
      for l in "${items[@]}"; do
        printf '%s\n' "$chosen" | grep -qxF -- "$l" || skip_now="$skip_now${skip_now:+|}${l%%"$SEP"*}"
      done
      IFS='|'
    done
    IFS="$IFS_was"
    a_apps_skip="$skip_now"
  elif [[ -z "$a_apps" ]]; then
    a_apps_skip=""
  fi
  put apps.groups "${a_apps//|/,}"
  put apps.skip "${a_apps_skip//|/,}"

  # What UnMacOS leaves alone, and how windows and the pointer behave
  pick_group keep "What should UnMacOS leave as it is? Tick to keep"
  pick_group desktop "Windows and pointer"

  a_weather="$(gum input --header "Weather in the bar: a city, airport code or zip, or auto (from your IP)" --value "${LIVE_WEATHER:-$(sget bar.weather)}")"
  put bar.weather "${a_weather:-auto}"

  echo; swrite - | grep -vE '^#|^$' | gum style --border rounded --padding "0 2"
  gum confirm "Save and apply these?" || { echo "Nothing changed."; exit 0; }
}

# --- Apply -----------------------------------------------------------------------

apply() {
  local old_theme old_weather old_hides
  old_theme="$(cat "$STATE/theme.name" 2>/dev/null || true)"
  old_weather="$(cat "$STATE/weather.location" 2>/dev/null || true)"
  old_hides="$(chezmoi execute-template '{{ (get (get . "desktop" | default dict) "mouse_hides_on_focus") }}' 2>/dev/null || true)"

  echo "==> chezmoi init --apply"
  chezmoi init --apply

  # Theme and weather are state the menus change, so set them only when they differ
  local theme weather want
  theme="$(sget look.theme)"; weather="$(sget bar.weather)"
  if [[ -n "$old_theme" && "$theme" != "$old_theme" ]] && command -v unmacos-theme-render >/dev/null; then
    echo "==> theme: $theme"; unmacos-theme-render "$theme"
  fi
  want="$weather"; [[ "$want" == auto ]] && want=""
  if [[ "$want" != "$old_weather" ]] && command -v unmacos-weather >/dev/null; then
    echo "==> weather: $weather"; unmacos-weather set "$weather" || true
  fi
  if [[ -n "$old_hides" && "$old_hides" != "$(sget desktop.mouse_hides_on_focus)" ]] && pgrep -xq rift; then
    echo "Hiding the pointer changes after: rift service restart"
  fi
  echo; checklist
}

# --- Checklist -----------------------------------------------------------------

checklist() {
  local major; major="$(sw_vers -productVersion | cut -d. -f1)"
  local todo=0 opens=()
  step() {  # step DONE(0/1/-) TEXT [SETTINGS-URL]
    case "$1" in
      0) printf '  \033[32m✓\033[0m %s\n' "$2" ;;
      -) printf '  \033[33m•\033[0m %s\n' "$2" ;;
      *) printf '  \033[31m○\033[0m %s\n' "$2"; todo=$((todo + 1)); [[ -n "${3:-}" ]] && opens+=("$2${SEP}$3") ;;
    esac
  }
  ok() { "$@" >/dev/null 2>&1 && echo 0 || echo 1; }

  echo "Steps macOS won't let a script do (✓ done, ○ to do, • can't tell: check yourself)"
  step "$(ok pgrep -xq rift)" "Accessibility: turn on rift and clipse, then rift service restart" \
    "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
  step - "Log out and back in once (Spaces and menu bar settings)"
  step - "The first menu you open makes Ghostty ask to run a command: allow it"
  if (( major >= 26 )) && ! is_true keep.ai; then
    step "$(ok sh -c 'profiles show -type configuration | grep -q io.github.unmacos.no-ai')" \
      "Approve the \"UnMacOS: no Apple Intelligence\" profile in Device Management" \
      "x-apple.systempreferences:com.apple.Profiles-Settings.extension"
  fi
  if is_true onepassword.enabled; then
    # shellcheck disable=SC2016 # expanded by sh -c
    step "$(ok sh -c '[ "$(op account list --format json | jq length)" -gt 0 ]')" \
      "1Password: sign in, then Settings > Developer > Integrate with 1Password CLI"
  fi
  step "$(ok test -s "$HOME/.cache/spotify-player/credentials.json")" "spotify_player: run it once to log in to Spotify"
  if ! is_true keep.firefox; then
    step - "Firefox: Pywalfox toolbar icon > Fetch Pywal colors (once)"
    step - "Firefox pages: Dark Reader > Settings > Advanced > Import ~/.local/state/unmacos/theme/darkreader.json"
  fi
  in_list appstore "$(sgetl apps.groups)" && step - "Sign in to the App Store, then: chezmoi apply (installs the App Store apps)"
  step "$(ok unmacos-doctor)" "unmacos-doctor says All good"

  if (( ${#opens[@]} )) && have_ui; then
    local l
    l="$(printf '%s\n' "${opens[@]}" | sed "s/${SEP}.*//" \
      | gum choose --header "Open the setting for one of these? (Esc to skip)" || true)"
    for o in "${opens[@]}"; do [[ "${o%%"$SEP"*}" == "$l" && -n "$l" ]] && open "${o#*"$SEP"}"; done
  fi
  return 0
}

# --- Main ------------------------------------------------------------------------

mode=ask; apply_after=1; file=""
while (( $# )); do
  case "$1" in
    --yes|-y)     mode="yes" ;;
    --no-apply)   apply_after=0 ;;
    --export)     mode="export"; [[ $# -gt 1 && "$2" != -* ]] && { file="$2"; shift; } ;;
    --import)     mode="import"; file="${2:?--import needs a file}"; shift ;;
    --checklist)  mode="checklist" ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; exit 2 ;;
  esac
  shift
done
command -v chezmoi >/dev/null || die "needs chezmoi (brew install chezmoi)"

case "$mode" in
  export)
    load_live; load_git
    if [[ -n "$file" ]]; then swrite "$file"; echo "Wrote $file" >&2
    else swrite -; fi
    exit 0 ;;
  checklist) checklist; exit 0 ;;
  import)
    [[ -r "$file" ]] || die "can't read $file"
    FROM="$file"; DATA="--no-data"
    settings validate "$file" || exit 1
    load_git ;;
  yes) load_live; load_git ;;
  ask)
    load_live; load_git
    if have_ui; then ask
    else echo "unmacos-setup: no terminal (or no gum): keeping the saved answers or defaults" >&2; fi ;;
esac

save
(( apply_after )) && apply
exit 0
