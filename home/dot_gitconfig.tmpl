# UnMacOS: git (name and email are optional; left empty, the user section is left out)
{{ if or .git.name .git.email -}}
[user]
{{- if .git.name }}
	name = {{ .git.name }}
{{- end }}
{{- if .git.email }}
	email = {{ .git.email }}
{{- end }}
{{ end -}}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[init]
	defaultBranch = master
