# UnMacOS: git (name/email asked on `chezmoi init`)
[user]
	name = {{ .name }}
	email = {{ .email }}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[init]
	defaultBranch = master
