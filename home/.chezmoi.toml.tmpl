{{- /*
  UnMacOS settings. The Settings schema (.chezmoidata/settings.toml) lists every Setting and its
  default; your Answers (~/.config/unmacos/setup.toml, written by unmacos-setup) are merged over
  those defaults the same way for every Setting, and templates read the result as .<group>.<key>.
  Copy setup.toml to a new Mac (or run unmacos-setup --import) to rebuild it the same way.

  This template runs before chezmoi's data exists, so it reads the schema file itself.
  Order for each Setting: the Answers' [group] table, then the group.key it moved from (the
  schema's "moved_from"), then the flat key older Answers files use
  (the schema's "legacy"; personal = true stands for every app group), then, for Settings marked
  "ask", a prompt (its default is the schema's; chezmoi init --promptDefaults takes it without
  asking), then the default. unmacos-settings migrate (run by chezmoi apply, and on the
  first read of the Answers) rewrites an old file into the [group] tables.
*/ -}}
{{- $schema := include (joinPath .chezmoi.sourceDir ".chezmoidata/settings.toml") | fromToml -}}
{{- $f := joinPath .chezmoi.homeDir ".config/unmacos/setup.toml" -}}
{{- $answers := dict -}}
{{- if stat $f }}{{ $answers = include $f | fromToml }}{{ end -}}

{{- $merged := dict -}}
{{- range $schema.settings -}}
  {{- $group := index $answers .group -}}
  {{- $value := .default -}}
  {{- $legacy := get . "legacy" -}}
  {{- $mg := dict -}}{{- $mk := "" -}}
  {{- with get . "moved_from" }}{{ $mg = index $answers (splitList "." . | first) }}{{ $mk = splitList "." . | last }}{{ end -}}
  {{- if and (kindIs "map" $group) (hasKey $group .key) -}}
    {{- $value = index $group .key -}}
  {{- else if and $mk (kindIs "map" $mg) (hasKey $mg $mk) -}}
    {{- /* a Setting that moved group (the schema's moved_from), until the file is migrated */ -}}
    {{- $value = index $mg $mk -}}
  {{- else if and $legacy (hasKey $answers $legacy) (not (kindIs "map" (index $answers $legacy))) -}}
    {{- $value = index $answers $legacy -}}
  {{- else if and (eq .group "apps") (eq .key "groups") (kindIs "bool" (get $answers "personal")) (get $answers "personal") -}}
    {{- /* the oldest Answers files: personal = true meant every optional app group */ -}}
    {{- $value = .choices -}}
  {{- else if and (get . "ask") (eq .type "bool") -}}
    {{- $value = promptBoolOnce $ (list .group .key) .label .default -}}
  {{- else if get . "ask" -}}
    {{- $value = promptStringOnce $ (list .group .key) .label .default -}}
  {{- end -}}
  {{- if not (hasKey $merged .group) }}{{ $_ := set $merged .group dict }}{{ end -}}
  {{- $_ := set (index $merged .group) .key $value -}}
{{- end -}}
{{ dict "data" $merged | toToml }}
