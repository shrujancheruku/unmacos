# UnMacOS — personal apps
# Installed only when you answer yes to "personal apps" during `chezmoi init`.
# Not needed for the desktop; edit freely.

tap "achannarasappa/tap"
tap "luckman212/tap"
tap "oven-sh/bun"
tap "stablyai/orca"
tap "supabase/tap"

# --- Dev tools ---
brew "cloudflared"
brew "cocoapods"
brew "composer"
brew "julia"
brew "luarocks"
brew "nvm"
brew "openjdk"
brew "pnpm"
brew "postgresql@18"
brew "rust"
brew "uv"
brew "yarn"
brew "ffmpeg"
brew "cabextract"
brew "zenity"
brew "wireguard-tools"
brew "mole"
brew "spicetify-cli"
brew "zork"
brew "achannarasappa/tap/ticker", trusted: true
brew "luckman212/tap/volctl", trusted: true
brew "oven-sh/bun/bun", trusted: true
brew "supabase/tap/supabase", trusted: true

# --- Apps ---
cask "android-cli"
cask "android-platform-tools"
cask "calibre"
cask "claude-code"
cask "gcloud-cli"
cask "google-chrome"
cask "heroic"
cask "logi-options+"
cask "mullvad-vpn"
cask "orbstack"
cask "stablyai/orca/orca", trusted: true
cask "porting-kit"
cask "slack"
cask "spotify"
cask "steam"
cask "stremio"
cask "the-unarchiver"
cask "tradingview"
cask "transmission"
cask "vlc"
cask "whatsapp"
cask "zulu@17"

# --- Mac App Store (sign in to the App Store first) ---
mas "Adobe Lightroom", id: 1451544217
mas "Xcode", id: 497799835
